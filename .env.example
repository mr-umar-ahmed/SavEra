# ======================================================================
# SAVERA — environment template. Copy to .env (backend) and frontend/.env.local (frontend).
# Never commit real values. Every key below is read by backend/app/config.py or the Next.js app.
# ======================================================================

# ---------- runtime ----------
APP_ENV=development                     # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- database (PostgreSQL 15 + TimescaleDB) ----------
# docker compose:  postgresql://postgres:postgres@db:5432/savera
# local portable:  postgresql://postgres:postgres@127.0.0.1:55432/savera   (scripts/dev-postgres.sh)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/savera
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/savera_test
POSTGRES_PASSWORD=postgres              # used by docker-compose db service only

# ---------- Supabase Auth ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key          # server only
SUPABASE_JWT_SECRET=                                     # legacy HS256 secret (Project Settings > API > JWT). Leave empty for ES256/JWKS projects.

# ---------- Google Cloud Vision (bill OCR) ----------
GCV_API_KEY=your-google-cloud-vision-api-key
TESSERACT_CMD=                          # optional path to tesseract binary for the fallback

# ---------- Firebase Cloud Messaging (push) ----------
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json   # HTTP v1 service account file (legacy server keys are deprecated)

# ---------- weather / storage / jobs ----------
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_TIMEOUT_SECONDS=3
UPLOAD_DIR=./uploads
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# ======================================================================
# Frontend (frontend/.env.local) — only NEXT_PUBLIC_* values reach the browser
# ======================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key   # sb_publishable_... or the legacy anon JWT
NEXT_PUBLIC_API_URL=http://localhost:8000                          # origin only; the client appends /api/v1
# Firebase web push (Phase 3 profile toggle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
